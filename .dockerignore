# Byte-compiled / optimized / DLL files (en cualquier nivel: sin **/ el patrón solo vale en la raíz)
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Virtual environments (uv sync --project backend crea backend/.venv)
**/venv/
**/env/
**/.venv/
**/.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Testing
**/.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation
docs/
*.md
!README.md

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# Misc
*.log
*.tmp
.DS_Store
Thumbs.db

# Old code
old/

# Archivos subidos en desarrollo y worktrees de Claude: no van a ninguna imagen
data/
.claude/
