# .env de la VM de test (D-101, docs/Ambiente-Test.md). Copiarlo a <PROJECT_DIR>/.env en la VM y completar lo marcado
# PROPIO. Nunca va al repo ni lleva credenciales productivas: la base es una copia de producción, con gente real, y nada
# puede salir hacia afuera. Los BORDES (lo que habla con servicios externos) quedan vacíos; cada uno se prueba con una
# prueba puntual y controlada: se pone una credencial de prueba para esa prueba (un room de test, un destinatario
# propio) y se vuelve a sacar.

# ===========================================
# FastAPI
# ===========================================
APP_NAME=Dicsys Core (test)
APP_VERSION=test
DEBUG=False
HOST=0.0.0.0
RELOAD=False
# como producción: gunicorn, uvicorn con 5 workers, la guarda de secretos y las cookies Secure
ENVIRONMENT=production
# el compose la pone en true en el scheduler y en false en el backend
CRON_ENABLED=false
SESSION_COOKIE_SECURE=

# PROPIO: valores aleatorios largos, distintos de los de producción (openssl rand -hex 32)
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# la sesión del navegador de F07 prendida: es lo que se viene a probar
AUTH_REFRESH_ENABLED=true
REFRESH_TOKEN_EXPIRE_DAYS=7
# la página de prueba de la sesión (F07-P12), en https://<test>/... solo si se publica el backend; si no, por túnel
PAGINA_DE_PRUEBA_DE_SESION=true

LIMITE_LOGIN_POR_CUENTA=10
LIMITE_2FA_POR_CUENTA=5
LIMITE_CORREOS_POR_CUENTA=3
LIMITE_INTENTOS_POR_IP=50

# vacío: usa SECRET_KEY. Ojo: los códigos de respaldo de la copia se hashearon con el pepper de producción y en test
# no valen (es lo esperado: los TOTP sí, porque el secreto está en la base)
BACKUP_CODES_PEPPER=
SEED_ADMIN_PASSWORD=

# La URL de test (F23-P05): resuelve al proxy por el comodín *.services.dicsys.ai
CORS_ORIGINS=["https://core-qa.services.dicsys.ai"]
FRONTEND_URL=https://core-qa.services.dicsys.ai

# BORDE: proveedor OpenID Connect para razorback, apagado (sin clave activa no firma nada)
OIDC_ISSUER=
OIDC_KID_ACTIVA=

# BORDE: ingreso con Google, apagado (el botón no aparece). Prueba puntual: un cliente OAuth de test con la URL de
# vuelta de test, y se saca
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ===========================================
# Puertos
# ===========================================
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=6000
BACKEND_PORT=6001
BACKEND_EXTERNAL_PORT=6001
FRONTEND_PORT=80
FRONTEND_EXTERNAL_PORT=80

# ===========================================
# PostgreSQL (la base de test, con la copia de producción)
# ===========================================
POSTGRES_USER=postgres
# PROPIO: distinta de la de producción (y la misma en DATABASE_URL)
POSTGRES_PASSWORD=
POSTGRES_DB=dicsys_core
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/dicsys_core

# ===========================================
# BORDE: email (SendGrid), apagado: sin key no sale ningún mail
# ===========================================
SENDGRID_API_KEY=
EMAIL_FROM=noreply-test@dicsys.ai

# ===========================================
# Storage
# ===========================================
STORAGE_LOCAL_PATH=/data/files
# PROPIO: el bucket de test (F23-P05), nunca el de producción. La identidad es la service account de la VM (ADC)
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=
# BORDE: Google Sheets, apagado (el compose monta secrets/sheets-lectura.json: en test, un archivo vacío)
GOOGLE_SHEETS_CREDENTIALS_PATH=

# PROPIO: los emails de quienes prueban recibos
RECIBOS_ADMIN_ALLOWED_EMAILS=

# ===========================================
# BORDE: Odoo, apagado (la sincronización de nómina no tiene a dónde conectarse)
# ===========================================
ODOO_HOST=
ODOO_PORT=8069
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# ===========================================
# BORDE: Webex (bot de avisos e integración lectora), apagado: sin token no sale ningún mensaje
# ===========================================
WEBEX_BOT_TOKEN=
WEBEX_DEFAULT_ROOM_ID=
WEBEX_SYNC_ALLOWED_DOMAINS=dicsys.com,dicsys.ai
WEBEX_READER_CLIENT_ID=
WEBEX_READER_CLIENT_SECRET=

# ===========================================
# BORDE: LLM (Gemini), apagado: los datos de la copia no salen a un proveedor externo
# ===========================================
LLM_ENABLED=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_STORAGE_PATH=/data/llm
