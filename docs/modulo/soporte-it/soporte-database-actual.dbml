// ═══════════════════════════════════════════════════════════════
// DICSYS CORE - Módulo Soporte IT - Diagrama de Base de Datos
// Última actualización: 2026-04-10
// Visualizar en: https://dbdiagram.io/
// ═══════════════════════════════════════════════════════════════

Project soporte_it_actual {
  database_type: 'PostgreSQL'
  Note: 'Estado actual del modelo de datos del módulo Soporte IT'
}

// ═══════════════════════════════════════════════════════════════
// TABLAS DE NÓMINA (Dependencias externas)
// ═══════════════════════════════════════════════════════════════

Table nomina_departamentos {
  id uuid [pk]
  nombre varchar(100) [not null]
  descripcion varchar(255)
  manager_id uuid [ref: > nomina_empleados.id]
  deleted_at timestamp
}

Table nomina_empleados {
  id uuid [pk]
  codigo varchar(50) [unique, not null]
  apellido varchar(100) [not null]
  nombre varchar(100) [not null]
  dni integer [not null]
  email_corporativo varchar(255)
  deleted_at timestamp
  
  Note: 'TABLA EXTERNA - Módulo de Nómina'
}

// ═══════════════════════════════════════════════════════════════
// TABLAS MAESTRAS DE CONFIGURACIÓN
// ═══════════════════════════════════════════════════════════════

Table soporte_tickets_estados {
  id uuid [pk]
  nombre varchar(100) [not null]
  clave varchar(100) [unique, not null]
  color varchar(50)
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  Note: 'Estados para tickets: abierto, en_progreso, resuelto, cerrado, etc.'
}

Table soporte_pedidos_estados {
  id uuid [pk]
  nombre varchar(100) [not null]
  clave varchar(100) [unique, not null]
  color varchar(50)
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  Note: 'Estados para pedidos de compra'
}

Table soporte_activos_marcas {
  id uuid [pk]
  nombre varchar(100) [unique, not null]
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  Note: 'Marcas: Lenovo, Dell, HP, etc.'
}

Table soporte_activos_tipos {
  id uuid [pk]
  nombre varchar(100) [unique, not null]
  clave varchar(100) [unique, not null]
  requiere_especificaciones boolean [not null, default: false]
  frecuencia_mantenimiento_meses integer [default: 0]
  activo boolean [not null, default: true]
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  Note: 'Tipos: notebook, monitor, mouse, teclado, etc.'
}

// ═══════════════════════════════════════════════════════════════
// SISTEMAS DISPONIBLES PARA ALTA/BAJA
// ═══════════════════════════════════════════════════════════════

Table soporte_sistemas_disponibles {
  id uuid [pk]
  clave varchar(100) [unique, not null, note: 'Identificador único: alta_email, alta_odoo, baja_svn, etc.']
  label varchar(255) [not null, note: 'Texto visible para el usuario']
  orden integer [not null, default: 0]
  tipo varchar(10) [not null, default: 'alta', note: 'alta o baja']
  clave_alta_ref varchar(100) [note: 'Para items de baja: clave del sistema de alta al que corresponde']
  activo boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)

  indexes {
    tipo
    activo
  }

  Note: 'Catálogo de sistemas habilitables/deshabilitables en alta/baja de colaborador. Poblado por seed. Los items de baja referencian su item de alta correspondiente via clave_alta_ref para derivar el checklist de baja automáticamente.'
}

// ═══════════════════════════════════════════════════════════════
// CATEGORÍAS Y SUBCATEGORÍAS
// ═══════════════════════════════════════════════════════════════

Table soporte_categorias {
  id uuid [pk]
  nombre_display varchar(100) [not null]
  nombre_normalizado varchar(100) [not null]
  tipo_ticket_asociado varchar(20) [not null, default: 'generico']
  departamento_id uuid [ref: > nomina_departamentos.id]
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  Note: 'Categorías principales de tickets. Soft delete.'
}

Table soporte_subcategorias {
  id uuid [pk]
  categoria_id uuid [ref: > soporte_categorias.id, not null]
  nombre_display varchar(100) [not null]
  nombre_normalizado varchar(100) [not null]
  tipo_ticket_asociado varchar(20) [not null, default: 'generico']
  departamento_id uuid [ref: > nomina_departamentos.id]
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  Note: 'Subcategorías vinculadas a categorías principales. Soft delete.'
}

// ═══════════════════════════════════════════════════════════════
// MATRIZ DE ESTADO FÍSICO
// ═══════════════════════════════════════════════════════════════

Table soporte_matriz_estado {
  id uuid [pk]
  pantalla varchar(50)
  teclado varchar(50)
  bateria varchar(50)
  carcasa_superior varchar(50)
  carcasa_inferior varchar(50)
  touchpad varchar(50)
  puertos varchar(50)
  cargador varchar(50)
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_by varchar(255)
  
  Note: 'Matriz descriptiva del estado físico de equipos. Los valores son texto libre (ej: Excelente, Bueno, Regular, Malo) validados en backend.'
}

// ═══════════════════════════════════════════════════════════════
// TICKETS (Joined Table Inheritance)
// ═══════════════════════════════════════════════════════════════

Table soporte_tickets {
  id uuid [pk]
  numero integer [unique, not null]
  tipo_ticket varchar(20) [not null, default: 'generico']
  titulo varchar(200) [not null]
  descripcion text
  estado_id uuid [ref: > soporte_tickets_estados.id, not null]
  prioridad varchar(50) [not null, default: 'media']
  subcategoria_id uuid [ref: > soporte_subcategorias.id, not null]
  es_falla boolean [not null, default: false]
  solicitante_id uuid [ref: > nomina_empleados.id, not null]
  asignado_id uuid [ref: > nomina_empleados.id]
  resolucion text
  fecha_inicio timestamp
  fecha_resolucion timestamp
  fecha_cierre timestamp
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by varchar(255)
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)
  
  indexes {
    numero
    tipo_ticket
    estado_id
    asignado_id
    solicitante_id
    subcategoria_id
  }
  
  Note: 'Tabla base de tickets (polimórfica). Soft delete.'
}

Table soporte_tickets_reparacion {
  id uuid [pk, ref: - soporte_tickets.id]
  activo_id uuid [ref: > soporte_activos.id, not null]
  diagnostico text
  solucion text
  costo_estimado numeric(10,2) [default: 0.0]
  costo_total_final numeric(10,2) [default: 0.0]
  matriz_entrada_id uuid [ref: > soporte_matriz_estado.id]
  matriz_salida_id uuid [ref: > soporte_matriz_estado.id]
  
  indexes {
    activo_id
  }
  
  Note: 'Tickets de reparación de activos'
}

Table soporte_tickets_alta_baja {
  id uuid [pk, ref: - soporte_tickets.id]
  colaborador_id uuid [ref: > nomina_empleados.id, not null]
  tipo_operacion varchar(10) [not null]
  entrega_kit_bienvenida boolean [default: false]
  activo_id uuid [ref: > soporte_activos.id, note: 'Equipo seleccionado, se asigna al resolver el ticket']
  matriz_estado_id uuid [ref: > soporte_matriz_estado.id]
  modalidad_trabajo varchar(30) [note: 'Presencial, Remoto, Híbrido']
  requiere_nextcloud boolean [default: false]
  listas_correo text [note: 'Lista de correos en los que incluir al colaborador']
  necesita_computadora boolean [default: false]
  gama_computadora varchar(50) [note: 'Básica, Media, Alta gama']
  cliente_servicio varchar(200) [note: 'Cliente y servicio al que está asignado. Autocompleta desde nómina.puesto']
  
  indexes {
    colaborador_id
    activo_id
  }
  
  Note: 'Tickets de alta/baja de empleados. El equipo se guarda al generar el acuerdo pero se asigna al colaborador recién al resolver el ticket.'
}

Table soporte_tickets_mantenimiento {
  id uuid [pk, ref: - soporte_tickets.id]
  activo_id uuid [ref: > soporte_activos.id, not null]
  mantenimiento_id uuid [ref: > soporte_mantenimiento_evento.id]
  detalle_tecnico text
  is_preventivo boolean [default: true]
  fecha_programada timestamp
  se_realizo boolean [default: false]
  
  indexes {
    activo_id
  }
  
  Note: 'Tickets de mantenimiento preventivo/correctivo'
}

// ═══════════════════════════════════════════════════════════════
// ACTIVOS IT (Joined Table Inheritance)
// ═══════════════════════════════════════════════════════════════

Table soporte_activos {
  id uuid [pk]
  clase_activo varchar(30) [not null, default: 'sin_especificaciones']
  nombre varchar(200) [not null]
  tipo_id uuid [ref: > soporte_activos_tipos.id, not null]
  marca_id uuid [ref: > soporte_activos_marcas.id]
  modelo varchar(100)
  numero_serie varchar(100) [unique]
  numero_inventario varchar(50) [unique]
  estado varchar(50) [default: 'disponible']
  asignado_id uuid [ref: > nomina_empleados.id]
  fecha_asignacion timestamp
  fecha_compra timestamp
  fecha_fin_garantia timestamp
  notas text
  fecha_ultimo_mantenimiento timestamp
  matriz_estado_id uuid [ref: > soporte_matriz_estado.id]
  deleted_at timestamp
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_at timestamp [default: `now()`]
  updated_by varchar(255)
  
  indexes {
    estado
    asignado_id
    tipo_id
    numero_serie
    numero_inventario
  }
  
  Note: 'Tabla base de activos IT (polimórfica). Soft delete.'
}

Table soporte_activos_especificaciones {
  id uuid [pk, ref: - soporte_activos.id]
  procesador varchar(150)
  memoria varchar(50)
  disco_principal varchar(100)
  disco_secundario varchar(100)
  mac_ethernet varchar(100)
  mac_wifi varchar(100)
  
  Note: 'Especificaciones técnicas para notebooks y equipos complejos'
}

// ═══════════════════════════════════════════════════════════════
// INSUMOS Y MOVIMIENTOS
// ═══════════════════════════════════════════════════════════════

Table soporte_insumos {
  id uuid [pk]
  nombre varchar(150) [not null]
  descripcion varchar(255)
  stock_actual integer [default: 0]
  stock_minimo integer [default: 0]
  unidad_medida varchar(20) [default: 'unidades']
  categoria_id uuid [ref: > soporte_categorias.id]
  deleted_at timestamp
  deleted_by varchar(255)
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_at timestamp [default: `now()`]
  updated_by varchar(255)
  
  Note: 'Catálogo de insumos: cables, mouses, teclados, etc. Con soft delete.'
}

Table soporte_tickets_insumos {
  id uuid [pk]
  ticket_id uuid [ref: > soporte_tickets.id, not null]
  insumo_id uuid [ref: > soporte_insumos.id, not null]
  cantidad integer [default: 1]
  costo_unitario numeric(10,2) [default: 0.0]
  generar_pedido_compra boolean [default: false]
  movimiento_insumo_id uuid [ref: > soporte_movimientos_insumos.id]
  pedido_compra_id uuid [ref: > soporte_pedidos_compra.id]
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_by varchar(255)
  
  indexes {
    ticket_id
    insumo_id
  }
  
  Note: 'Consumo de insumos en tickets'
}

Table soporte_movimientos_insumos {
  id uuid [pk]
  insumo_id uuid [ref: > soporte_insumos.id, not null]
  tipo varchar(20) [not null]
  cantidad integer [not null]
  activo_id uuid [ref: > soporte_activos.id]
  empleado_id uuid [ref: > nomina_empleados.id]
  empleado_asignador_id uuid [ref: > nomina_empleados.id]
  pedido_compra_id uuid [ref: > soporte_pedidos_compra.id]
  motivo varchar(255)
  fecha_movimiento timestamp [default: `now()`]
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_by varchar(255)
  
  indexes {
    insumo_id
    tipo
    fecha_movimiento
  }
  
  Note: 'Tipos: ingreso, consumo, devolucion, ajuste'
}

// ═══════════════════════════════════════════════════════════════
// EVIDENCIAS
// ═══════════════════════════════════════════════════════════════

Table soporte_evidencias {
  id uuid [pk]
  url varchar(500) [not null]
  tipo varchar(50) [not null]
  categoria varchar(50) [not null, default: 'general', note: 'general, acuerdo_firmado, estado_equipo']
  ticket_id uuid [ref: > soporte_tickets.id]
  activo_id uuid [ref: > soporte_activos.id]
  historial_id uuid [ref: > soporte_historial_activo.id]
  deleted_at timestamp
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_by varchar(255)
  
  indexes {
    tipo
    categoria
    ticket_id
    activo_id
  }
  
  Note: 'Fotos, documentos, capturas de pantalla. Soft delete. Categoría diferencia acuerdos firmados de evidencias generales.'
}

// ═══════════════════════════════════════════════════════════════
// PEDIDOS DE COMPRA
// ═══════════════════════════════════════════════════════════════

Table soporte_pedidos_compra {
  id uuid [pk]
  numero varchar(50) [unique, not null]
  tipo_pedido varchar(20) [default: 'insumo']
  descripcion text
  monto_estimado numeric(12,2) [default: 0.0]
  monto_final numeric(12,2) [default: 0.0]
  estado_id uuid [ref: > soporte_pedidos_estados.id]
  fecha_solicitud timestamp [default: `now()`]
  fecha_recepcion timestamp
  solicitante_id uuid [ref: > nomina_empleados.id]
  ticket_id uuid [ref: > soporte_tickets.id]
  insumo_id uuid [ref: > soporte_insumos.id, note: 'Insumo vinculado al pedido']
  cantidad_solicitada integer [default: 0]
  cantidad_recibida integer [default: 0]
  notas text
  requiere_doble_aprobacion boolean [not null, default: false]
  deleted_at timestamp
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_at timestamp [default: `now()`]
  updated_by varchar(255)
  
  indexes {
    numero
    estado_id
    solicitante_id
  }
  
  Note: 'Pedidos de compra de insumos o servicios. Monto > 100k requiere doble aprobación. Soft delete.'
}

Table soporte_pedidos_presupuestos {
  id uuid [pk]
  pedido_id uuid [ref: > soporte_pedidos_compra.id]
  proveedor varchar(200)
  url_archivo varchar(500)
  articulo_descripcion text
  monto numeric(12,2)
  es_seleccionado boolean [default: false]
  es_obligatorio boolean [default: true]
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_by varchar(255)
  
  indexes {
    pedido_id
  }
  
  Note: 'Presupuestos asociados a pedidos. es_obligatorio: TRUE=obligatorio, FALSE=opcional'
}

Table soporte_pedidos_aprobaciones {
  id uuid [pk]
  pedido_id uuid [ref: > soporte_pedidos_compra.id]
  departamento_id uuid [ref: > nomina_departamentos.id]
  aprobador_id uuid [ref: > nomina_empleados.id]
  estado varchar(50) [default: 'pendiente']
  fecha_decision timestamp
  observaciones text
  orden_aprobacion integer [default: 1]
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_by varchar(255)
  
  indexes {
    pedido_id
    departamento_id
  }
  
  Note: 'Aprobaciones por departamento (Admin, Customer Service)'
}

// ═══════════════════════════════════════════════════════════════
// AUDITORÍA Y EVENTOS
// ═══════════════════════════════════════════════════════════════

Table soporte_historial_activo {
  id uuid [pk]
  activo_id uuid [ref: > soporte_activos.id]
  colaborador_id uuid [ref: > nomina_empleados.id]
  responsable_id uuid [ref: > nomina_empleados.id]
  fecha_hora timestamp [default: `now()`]
  tipo_evento varchar(50)
  notas_adicionales text
  matriz_estado_id uuid [ref: > soporte_matriz_estado.id]
  pedido_compra_id uuid [ref: > soporte_pedidos_compra.id]
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_at timestamp [default: `now()`]
  updated_by varchar(255)
  
  indexes {
    activo_id
    fecha_hora
  }
  
  Note: 'Historial de eventos: asignación, devolución, reparación, etc.'
}

Table soporte_ticket_checklist_items {
  id uuid [pk]
  ticket_id uuid [ref: > soporte_tickets.id, not null]
  sistema_id uuid [ref: > soporte_sistemas_disponibles.id, note: 'FK al catálogo de sistemas. nullable para compatibilidad con items legacy']
  item_clave varchar(100) [not null, note: 'Clave del sistema: alta_email, baja_odoo, etc.']
  item_label varchar(255) [not null, note: 'Texto visible copiado del catálogo al momento de crear el ticket']
  completado boolean [not null, default: false]
  completado_por varchar(255)
  completado_at timestamp
  orden integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  updated_by varchar(255)

  indexes {
    ticket_id
    sistema_id
  }

  Note: 'Checklist de proceso para tickets de alta/baja. Los ítems se crean automáticamente al crear el ticket según los sistemas seleccionados por RRHH.'
}

Table soporte_mantenimiento_evento {
  id uuid [pk]
  activo_id uuid [ref: > soporte_activos.id]
  asignado_id uuid [ref: > nomina_empleados.id]
  fecha_ejecucion timestamp [default: `now()`]
  estado_anterior varchar(20)
  estado_nuevo varchar(20)
  fecha_hora timestamp [default: `now()`]
  notas text
  created_at timestamp [default: `now()`]
  created_by varchar(255)
  updated_at timestamp [default: `now()`]
  updated_by varchar(255)
  
  indexes {
    activo_id
    fecha_hora
  }
  
  Note: 'Eventos de mantenimiento preventivo/correctivo'
}
